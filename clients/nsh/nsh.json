{
  "name": "雁字",
  "id": "io.github.cax.anser",
  "version": "0.7.4",
  "build": 12,
  "icon": "assets/logo.png",
  "theme": "theme.json",
  "dependencies": {
    "anser-client-native": { "path": "./native" }
  },
  "appearance": "system",
  "schemes": ["anser"],
  "window": {
    "title": "雁字",
    "defaultSize": { "width": 1120, "height": 760 },
    "minSize": { "width": 420, "height": 540 }
  },
  "capabilities": {
    "application": true,
    "openUrl": { "schemes": ["https"] },
    "clipboard": true,
    "notifications": true,
    "picker": true,
    "statusBar": true,
    "network": {
      "http": [
        {
          "host": "*",
          "schemes": ["https"],
          "methods": ["GET", "POST", "PUT", "DELETE"],
          "pathPrefixes": ["/v1"]
        },
        { "host": "localhost", "scheme": "http", "pathPrefix": "/v1" },
        { "host": "127.0.0.1", "scheme": "http", "pathPrefix": "/v1" },
        { "host": "::1", "scheme": "http", "pathPrefix": "/v1" }
      ]
    }
  }
}
